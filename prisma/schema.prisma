generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EventStatus {
  draft
  published
  closed
}

enum SessionStatus {
  open
  closed
  cancelled
}

enum BookingType {
  self_selected
  auto_allotted
}

enum BookingStatus {
  confirmed
  cancelled_by_admin
}

enum AckStatus {
  sent
  failed
}

model User {
  id         String   @id @default(cuid())
  name       String
  isbEmail   String   @unique @map("isb_email")
  pgpId      String   @unique @map("pgp_id")
  isAdmin    Boolean  @default(false) @map("is_admin")
  section    String? // cohort section, e.g. "G" — reference only, not used in booking logic
  studyGroup String?  @map("study_group") // e.g. "G12" — reference only, unrelated to cohortSplit below
  cohortSplit String? @map("cohort_split") // e.g. "G1"/"G2" — mandatory-attendance half-section split, drives group booking override
  createdAt  DateTime @default(now()) @map("created_at")
  announcementsSeenAt DateTime? @map("announcements_seen_at") // drives the unread bell dot

  createdEvents     Event[]                @relation("EventCreatedBy")
  ticketAllotments  EventTicketAllotment[]
  bookings          Booking[]
  loginAttempts     LoginAttempt[]
  announcements     Announcement[]         @relation("AnnouncementCreatedBy")
  attendanceGrants      SessionAttendanceGrant[] @relation("AttendanceGrantee")
  attendanceGrantsGiven SessionAttendanceGrant[] @relation("AttendanceGrantedBy")

  @@map("users")
}

model Event {
  id                  String      @id @default(cuid())
  name                String
  description         String?
  startDate           DateTime    @map("start_date")
  endDate             DateTime    @map("end_date")
  bookingDeadline     DateTime    @map("booking_deadline")
  status              EventStatus @default(draft)
  overlapCheckEnabled Boolean     @default(true) @map("overlap_check_enabled")
  createdById         String      @map("created_by")
  createdBy           User        @relation("EventCreatedBy", fields: [createdById], references: [id])
  createdAt           DateTime    @default(now()) @map("created_at")

  sessions         Session[]
  ticketAllotments EventTicketAllotment[]
  bookings         Booking[]
  announcements    Announcement[]

  @@map("events")
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  body        String
  eventId     String?  @map("event_id") // null = global (visible to every student)
  createdById String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  event     Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy User   @relation("AnnouncementCreatedBy", fields: [createdById], references: [id])

  @@index([createdAt])
  @@map("announcements")
}

model EventTicketAllotment {
  id              String   @id @default(cuid())
  eventId         String   @map("event_id")
  userId          String   @map("user_id")
  ticketsAllotted Int      @map("tickets_allotted")
  ticketsUsed     Int      @default(0) @map("tickets_used")
  createdAt       DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("event_ticket_allotments")
}

model Session {
  id                  String        @id @default(cuid())
  eventId             String        @map("event_id")
  title               String
  description         String?
  dayLabel            String        @map("day_label")
  startsAt            DateTime      @map("starts_at")
  endsAt              DateTime      @map("ends_at")
  venueName            String        @map("venue_name")
  venueLocation        String?       @map("venue_location")
  capacity             Int
  bookedCount          Int           @default(0) @map("booked_count")
  speakerProfileId     String?       @map("speaker_profile_id")
  speakerDescription   String?       @map("speaker_description")
  status               SessionStatus @default(open)
  createdAt            DateTime      @default(now()) @map("created_at")

  // Detail-page enrichment fields — all optional, purely additive. When empty the detail
  // page falls back to the fields above (speakerDescription etc.) or hides the section.
  // `speakers` is the multi-speaker source of truth: a JSON array of
  // { name, role, photoUrl, bio, profileUrl }. The flat speakerName/Role/… fields below are
  // kept mirrored to the FIRST speaker so legacy readers (email, older sessions) still work.
  speakers             Json?
  speakerName          String?       @map("speaker_name")
  speakerRole          String?       @map("speaker_role")
  speakerPhotoUrl      String?       @map("speaker_photo_url")
  speakerBio           String?       @map("speaker_bio")
  speakerProfileUrl    String?       @map("speaker_profile_url")
  venueDescription     String?       @map("venue_description")
  venuePhotoUrl        String?       @map("venue_photo_url")
  venueMapUrl          String?       @map("venue_map_url")
  campus               String?
  eventType            String?       @map("event_type")
  organizedBy          String?       @map("organized_by") // legacy free-text, no longer shown or edited — superseded by `club`
  club                 String?       // stable club value from lib/clubs.ts CLUBS (e.g. "consulting")
  keyTakeaways         String?       @map("key_takeaways") // newline-separated bullets
  agenda               String?
  whoShouldAttend      String?       @map("who_should_attend")

  event             Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bookings          Booking[]
  attendanceGrants  SessionAttendanceGrant[]
  tracks            SessionTrack[]

  @@index([eventId])
  @@map("sessions")
}

/**
 * A "table track" under a Women in Business (club "wib") session — see lib/wibTracks.ts. Each
 * track is a mini-session with its own capacity + speaker; a student books exactly one. Only WIB
 * sessions have these rows; every other session has none and behaves exactly as before.
 */
model SessionTrack {
  id          String @id @default(cuid())
  sessionId   String @map("session_id")
  track       String // stable value from lib/wibTracks.ts WIB_TRACKS (e.g. "finance")
  capacity    Int
  bookedCount Int    @default(0) @map("booked_count")

  speakerName       String? @map("speaker_name")
  speakerRole       String? @map("speaker_role")
  speakerPhotoUrl   String? @map("speaker_photo_url")
  speakerBio        String? @map("speaker_bio")
  speakerProfileUrl String? @map("speaker_profile_url")

  createdAt DateTime @default(now()) @map("created_at")

  session  Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@unique([sessionId, track])
  @@index([sessionId])
  @@map("session_tracks")
}

/** Grants a non-admin user permission to mark attendance for one specific session. */
model SessionAttendanceGrant {
  id          String   @id @default(cuid())
  sessionId   String   @map("session_id")
  userId      String   @map("user_id")
  grantedById String   @map("granted_by")
  createdAt   DateTime @default(now()) @map("created_at")

  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User    @relation("AttendanceGrantee", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User    @relation("AttendanceGrantedBy", fields: [grantedById], references: [id])

  @@unique([sessionId, userId])
  @@index([userId])
  @@map("session_attendance_grants")
}

model Booking {
  id            String        @id @default(cuid())
  userId        String        @map("user_id")
  eventId       String        @map("event_id")
  sessionId     String        @map("session_id")
  bookingType   BookingType   @map("booking_type")
  status        BookingStatus @default(confirmed)
  bookedAt      DateTime      @default(now()) @map("booked_at")
  // Which WIB table track this booking is for; null for every non-WIB booking.
  sessionTrackId String?      @map("session_track_id")
  adminNote     String?       @map("admin_note")
  overriddenBy  String?       @map("overridden_by")
  overriddenAt  DateTime?     @map("overridden_at")
  attended             Boolean?  @map("attended") // null = not yet marked
  attendanceMarkedBy   String?   @map("attendance_marked_by")
  attendanceMarkedAt   DateTime? @map("attendance_marked_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  session      Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionTrack SessionTrack? @relation(fields: [sessionTrackId], references: [id], onDelete: SetNull)

  acknowledgmentLogs AcknowledgmentLog[]

  @@unique([userId, sessionId])
  @@index([eventId])
  @@index([sessionId])
  @@map("bookings")
}

model AcknowledgmentLog {
  id        String    @id @default(cuid())
  bookingId String    @map("booking_id")
  channel   String    @default("email")
  status    AckStatus
  detail    String?
  sentAt    DateTime  @default(now()) @map("sent_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("acknowledgment_logs")
}

model LoginAttempt {
  id          String   @id @default(cuid())
  identifier  String   // isbEmail lowercased, used as the rate-limit key
  userId      String?  @map("user_id")
  success     Boolean
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([identifier, createdAt])
  @@map("login_attempts")
}
