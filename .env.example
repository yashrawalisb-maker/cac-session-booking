# Postgres (Neon). DATABASE_URL = pooled (PgBouncer) connection, used by the running app.
# DIRECT_URL = unpooled connection, used only by the Prisma CLI (migrate/seed/studio).
DATABASE_URL="postgresql://user:password@host/db?sslmode=require&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# Auth.js
AUTH_SECRET="" # generate via: npx auth secret
AUTH_TRUST_HOST="true"

# Microsoft Entra ID (Azure AD) app registration
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER="" # e.g. https://login.microsoftonline.com/<tenant-id>/v2.0

# Resend (optional in dev — omit to log emails to the console instead of sending)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="CAC Session Booking <onboarding@resend.dev>"
